# Database connection string.
DATABASE_URL=postgres://codingladies:codingladies@localhost:5432/codingladies

# Only needed for docker-compose.prod.yml — the database password.
# Use a long random string in production.
POSTGRES_PASSWORD=change-me

# Super admin email. This account gets access to /admin to manage staff.
CLA_ADMIN_EMAIL=claude@codingladies.org

# Optional. How many connections one process may hold. Default is 12.
# Lower when sharing a managed cluster (e.g. 25-connection limit).
# Live updates take one more on top, for LISTEN.
# DATABASE_POOL_MAX=5

# Registration is closed for internal use — admin creates accounts via /admin.
USHABTI_SIGNUP=closed
